# General
HOSTING_URL=https://interviewmasterai.vercel.app

# Convex
# Replace with actual values in your local setup or production environment
CONVEX_DEPLOYMENT=dev:<your-deployment-name>
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment-name>.convex.cloud

# Analytics
GA_ID=""  # Google Analytics ID
MC_ID=""  # Mailchimp ID

# Stripe
# Replace with your actual Stripe URL endpoint
STRIPE_URL_ENDPOINT=https://<your-deployment-name>.convex.site/stripe

# AI (server-side). New API routes read GEMINI_API_KEY first.
GEMINI_API_KEY=""

# Email (nodemailer, Gmail). Coaching requests are logged, not sent, when these are empty.
ADMIN_EMAIL=""
EMAIL_USER=""
EMAIL_PASS=""
